{
  "log": {
    "level": "error",
    "output": "box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "sky.rethinkdns.com",
        "domain_resolver": "dns-hosts",
        "detour": "estonec"
      },
      {
        "tag": "dns-hosts",
        "type": "hosts",
        "predefined": {
          "sky.rethinkdns.com": [
            "104.17.147.22",
            "104.17.148.22",
            "8.6.112.0",
            "8.47.69.0",
            "2a06:98c1:3123:8000::",
            "2a06:98c1:3122:8000::"
          ]
        }
      },
      {
        "tag": "dns-local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "domain": "sky.rethinkdns.com",
        "server": "dns-hosts"
      },
      {
        "domain_suffix": ".local",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-local",
        "strategy": "ipv4_only",
        "disable_cache": true
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "stack": "mixed",
      "tag": "tun-in",
      "strict_route": true,
      "endpoint_independent_nat": true
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "estonec",
      "server": "45.12.28.158",
      "server_port": 443,
      "uuid": "a6d1f3e4-b0f5-4d34-b9a6-e91f9d8bce3f",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "yahoo.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "zWIV7H_vKYWxlZZPyya5ia5kBhSGtlb0fma6BEbb0Wo",
          "short_id": "65656570"
        }
      },
      "packet_encoding": "xudp"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain_suffix": ".local",
        "outbound": "direct"
      },
      {
        "domain_suffix": ".ru",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geoip-ru",
          "geosite-ru"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-ads",
          "geosite-malware",
          "geosite-phishing",
          "geosite-cryptominers",
          "geoip-malware",
          "geoip-phishing"
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
